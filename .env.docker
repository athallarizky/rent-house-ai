# Kos AI — Environment variables untuk Docker
# Copy file ini ke .env (atau biarkan, docker compose baca otomatis)

# JWT secret key (ganti di production!)
JWT_SECRET=kos-ai-secret-change-in-production

# API URL untuk frontend (biarkan localhost, browser yang akses)
PUBLIC_API_URL=http://localhost:4000

# LLM defaults (bisa diubah via halaman /settings setelah login)
LLM_BASE_URL=https://api.z.ai/api/coding/paas/v4/
LLM_MODEL=glm-4.5-air

# Geo-router URL (internal Docker network)
GEO_ROUTER_URL=http://geo-router:3001

# ChromaDB
CHROMA_PATH=/app/data/chroma_db
COLLECTION_NAME=kos_indonesia

# Embedding model (Sprint 11: default e5-small — 449 MB, 384-dim, ~12× faster
# ingest + ~3-4× faster search vs bge-m3). Override to BAAI/bge-m3 only for
# A/B testing — requires chroma_db wipe + full re-ingest (dim mismatch).
EMBED_MODEL=intfloat/multilingual-e5-small

# Scraper
SEARCH_TOP_K=20
SCRAPER_STALE_DAYS=30
