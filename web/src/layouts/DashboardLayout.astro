---
import '../styles/globals.css';
import { noFlashScript } from '../lib/theme';
import MobileNav from '../components/MobileNav';

interface Props {
  title?: string;
  active?: 'home' | 'search' | 'pipeline' | 'users' | 'settings';
}

const { title = 'Kos AI', active } = Astro.props;
const currentPath = Astro.url.pathname;
const isActive = (key: string, href: string) =>
  active === key || currentPath === href || currentPath.startsWith(href + '/');
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline set:html={noFlashScript} />
  </head>
  <body>
    <div class="flex h-screen bg-background">
      <!-- Sidebar -->
      <aside class="hidden md:flex w-60 shrink-0 border-r border-border bg-card flex-col">
        <div class="border-b border-border p-5">
          <a href="/" class="flex items-center gap-2">
            <span class="text-2xl">🏠</span>
            <div>
              <h1 class="text-lg font-bold leading-none">Kos AI</h1>
              <p class="text-xs text-muted-foreground mt-1">Cari kos dengan AI</p>
            </div>
          </a>
        </div>

        <nav class="flex-1 space-y-1 p-3">
          <a
            href="/"
            class={`flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors ${
              isActive('home', '/')
                ? 'bg-primary/10 text-primary'
                : 'text-muted-foreground hover:bg-accent hover:text-foreground'
            }`}
          >
            <span class="text-base">🏡</span>
            Beranda
          </a>
          <a
            href="/search"
            class={`flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors ${
              isActive('search', '/search')
                ? 'bg-primary/10 text-primary'
                : 'text-muted-foreground hover:bg-accent hover:text-foreground'
            }`}
          >
            <span class="text-base">🔍</span>
            Pencarian
          </a>
          <a
            href="/pipeline"
            class={`flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors ${
              isActive('pipeline', '/pipeline')
                ? 'bg-primary/10 text-primary'
                : 'text-muted-foreground hover:bg-accent hover:text-foreground'
            }`}
            id="nav-pipeline"
          >
            <span class="text-base">📊</span>
            Pipeline
          </a>
          <a
            href="/users"
            class={`flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors ${
              isActive('users', '/users')
                ? 'bg-primary/10 text-primary'
                : 'text-muted-foreground hover:bg-accent hover:text-foreground'
            }`}
            id="nav-users"
          >
            <span class="text-base">👥</span>
            Users
          </a>
          <a
            href="/settings"
            class={`flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors ${
              isActive('settings', '/settings')
                ? 'bg-primary/10 text-primary'
                : 'text-muted-foreground hover:bg-accent hover:text-foreground'
            }`}
            id="nav-settings"
          >
            <span class="text-base">⚙️</span>
            Pengaturan
          </a>
        </nav>

        <div class="border-t border-border p-4 space-y-3">
          <div id="auth-user" class="text-xs text-muted-foreground truncate hidden"></div>
          <button
            id="logout-btn"
            onclick="(function(){localStorage.removeItem('kos-ai.auth');window.location.href='/login'})()"
            class="hidden w-full flex items-center gap-2 rounded-lg px-3 py-2 text-sm text-muted-foreground hover:bg-accent hover:text-foreground transition-colors text-left"
          >
            <span class="text-base">🚪</span>
            Keluar
          </button>
          <p class="text-xs text-muted-foreground">Kos AI v0.1.0</p>
        </div>

        <script>
          try {
            const raw = localStorage.getItem("kos-ai.auth");
            if (raw) {
              const auth = JSON.parse(raw);
              if (auth.user) {
                const el = document.getElementById("auth-user");
                if (el) { el.textContent = auth.user.email + "  ·  " + auth.user.role; el.classList.remove("hidden"); }
                const btn = document.getElementById("logout-btn");
                if (btn) btn.classList.remove("hidden");
                if (auth.user.role !== "admin") {
                  ["nav-users"].forEach((id) => {
                    const el = document.getElementById(id);
                    if (el) el.classList.add("hidden");
                  });
                }
              }
            }
          } catch(e) {}
        </script>
      </aside>

      <!-- Main Content -->
      <main class="flex-1 overflow-hidden flex flex-col">
        <!-- Mobile top bar (global nav hamburger). Desktop uses the sidebar. -->
        <header class="md:hidden flex items-center gap-2 border-b border-border bg-card px-3 py-2.5">
          <MobileNav currentPath={currentPath} client:load />
          <a href="/" class="flex items-center gap-2">
            <span class="text-lg">🏠</span>
            <span class="font-bold text-sm">Kos AI</span>
          </a>
        </header>
        <slot />
      </main>
    </div>
  </body>
</html>
