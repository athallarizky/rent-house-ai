---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import ProviderSettings from '../components/ProviderSettings';
---

<DashboardLayout title="Pengaturan - Kos AI" active="settings">
  <div class="overflow-y-auto thin-scroll">
    <div class="max-w-2xl mx-auto px-6 py-8">
      <div class="mb-6">
        <h1 class="text-2xl font-bold">Pengaturan</h1>
        <p class="text-sm text-muted-foreground mt-1">
          Konfigurasi provider LLM (Z.AI) dan informasi data.
        </p>
      </div>

      <ProviderSettings client:load />
    </div>
  </div>
</DashboardLayout>
