# ============================================================
# Stage 1: Build Go scraper binary
# ============================================================
FROM golang:1.26-bookworm AS go-builder

WORKDIR /build

# Cache module downloads — copy go.mod/go.sum first
COPY services/scraper/google-maps-scraper/go.mod services/scraper/google-maps-scraper/go.sum ./
RUN go mod download

# Copy source and build
COPY services/scraper/google-maps-scraper/ ./
RUN CGO_ENABLED=0 go build -ldflags="-w -s" -o gmaps-scraper .

# ============================================================
# Stage 2: Python runtime with Chromium + Node.js + Go binary
# ============================================================
FROM python:3.11-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates \
    libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 \
    libcups2 libdrm2 libdbus-1-3 libxkbcommon0 \
    libx11-6 libxcomposite1 libxdamage1 libxext6 \
    libxfixes3 libxrandr2 libgbm1 libpango-1.0-0 \
    libcairo2 libasound2 libatspi2.0-0 \
    chromium \
    && ln -s /usr/bin/chromium /usr/bin/chromium-browser 2>/dev/null || true \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Node.js required by playwright-go driver (used by Google Maps scraper)
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

ENV PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium

# Copy pre-built Go scraper binary from stage 1
COPY --from=go-builder /build/gmaps-scraper /app/services/scraper/google-maps-scraper/gmaps-scraper
RUN chmod +x /app/services/scraper/google-maps-scraper/gmaps-scraper

WORKDIR /app

# Install PyTorch CPU-only FIRST so sentence-transformers won't pull CUDA torch
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

RUN pip install --no-cache-dir \
    fastapi>=0.115 "uvicorn[standard]" \
    "python-jose[cryptography]>=3.3" "passlib[bcrypt]>=1.7" "bcrypt==4.0.1" \
    "chromadb>=0.5" "sentence-transformers>=3.0" "openai>=1.0"

COPY api/ ./api/
COPY services/ ./services/
COPY scripts/docker-startup.sh /usr/local/bin/docker-startup.sh
RUN chmod +x /usr/local/bin/docker-startup.sh

# Ensure compiled Go binary overwrites any source copied above
COPY --from=go-builder /build/gmaps-scraper /app/services/scraper/google-maps-scraper/gmaps-scraper
RUN chmod +x /app/services/scraper/google-maps-scraper/gmaps-scraper

RUN mkdir -p data/raw data/cleaned data/chroma_db && \
    ln -sf /app/services/geo-router/kodepos/data/kodepos.json /app/data/kodepos.json

ENV GEO_ROUTER_URL=http://geo-router:3001

EXPOSE 8080

CMD ["docker-startup.sh"]
