# ─── Database ─────────────────────────────────────────────────
# Password WAJIB diganti dari default. Generate: openssl rand -hex 16
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# DSN yang dipakai serve & worker.
# Format: postgres://postgres:PASSWORD@postgres:5432/gmaps_pro?sslmode=disable
# Host harus = "postgres" (nama service di Docker network).
DATABASE_URL=postgres://postgres:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/gmaps_pro?sslmode=disable

# ─── Encryption Key (WAJIB) ──────────────────────────────────
# Hex-encoded 32-byte key untuk encrypt sensitive data di DB
# (password proxy, API keys, dll).
#
# Generate dengan: openssl rand -hex 32
#
# ⚠️  JANGAN pakai default value (akan ditolak serve).
# ⚠️  BACKUP key ini. Kalau hilang, data terenkripsi nggak bisa di-decrypt.
ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# ─── Worker ──────────────────────────────────────────────────
# Jumlah worker instances yang jalan paralel (Chromium instances).
# AWS EC2 tanpa proxy: 1 (aman, nggak OOM)
# AWS EC2 + proxy residensial: 2-3
# VPS 8GB: 4-6
CONCURRENCY=1

# Restart worker setiap N jobs. Refresh browser state, clear cookies.
# AWS tanpa proxy: 20 (lebih sering restart = lebih "fresh")
# AWS + proxy: 100 (default)
MAX_JOBS_PER_CYCLE=100

# ─── Fast Mode ───────────────────────────────────────────────
# true  = stealth HTTP requests (10x cepat, tapi gampang kena block)
# false = full Chromium (default, paling reliable)
FAST_MODE=false

# ─── Proxies (HIGHLY RECOMMENDED untuk AWS/cloud) ────────────
# Comma-separated proxy URLs. Scraper akan rotate otomatis.
# Format: scheme://user:pass@host:port
#
# Provider populer:
#   - Webshare (~$3/bulan, 100 residential)
#   - IPRoyal (~$7/bulan)
#   - Bright Data (~$15/bulan, premium)
#
# Example (Webshare rotating):
# PROXIES=http://user-rotate:pass@p.webshare.io:80
#
# Example (multiple static):
# PROXIES=http://user:pass@proxy1.example.com:8080,http://user:pass@proxy2.example.com:8080
PROXIES=

# ─── Database connection pool (advanced) ─────────────────────
# Default values OK untuk small deployment.
# DB_MAX_CONNS=10
# DB_MIN_CONNS=2
# DB_MAX_CONN_LIFETIME=1h
# DB_MAX_CONN_IDLE_TIME=30m
